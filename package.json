{
  "name": "pi-gsd",
  "version": "0.1.0",
  "description": "Pi adapter for official Open GSD without forking workflows",
  "type": "module",
  "bin": {
    "pi-gsd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "generated/prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/extension.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "generate": "node dist/cli.js generate"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": ["pi-package", "gsd", "open-gsd", "agent", "planning"],
  "license": "MIT",
  "dependencies": {
    "@opengsd/get-shit-done-redux": "latest"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "pi": {
    "extensions": ["./dist/extension.js"],
    "prompts": ["./generated/prompts"]
  }
}
